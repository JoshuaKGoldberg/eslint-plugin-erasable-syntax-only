{
	"name": "eslint-plugin-erasable-syntax-only",
	"version": "0.7.3",
	"description": "ESLint plugin to granularly enforce TypeScript's erasableSyntaxOnly flag. ❎",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JoshuaKGoldberg/eslint-plugin-erasable-syntax-only.git"
	},
	"license": "MIT",
	"author": {
		"name": "Josh Goldberg ✨",
		"email": "npm@joshuakgoldberg.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "tsdown",
		"build:docs": "pnpm build --no-dts && eslint-doc-generator",
		"format": "prettier .",
		"lint": "eslint . --max-warnings 0",
		"lint:docs": "eslint-doc-generator --check",
		"lint:knip": "knip",
		"lint:knip:production": "knip --production",
		"lint:spelling": "cspell \"**\" \".github/**/*\"",
		"prepare": "husky",
		"test": "vitest",
		"tsc": "tsc"
	},
	"dependencies": {
		"@typescript-eslint/utils": "^8.59.0",
		"cached-factory": "^0.3.0"
	},
	"devDependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "9.0.0",
		"@release-it/conventional-changelog": "12.0.0",
		"@types/node": "26.6.5",
		"@typescript-eslint/rule-tester": "8.73.0",
		"@vitest/coverage-v8": "5.1.0",
		"@vitest/eslint-plugin": "1.6.27",
		"console-fail-test": "0.10.0",
		"create-typescript-app": "2.87.18",
		"cspell": "10.5.2",
		"eslint": "10.15.0",
		"eslint-doc-generator": "3.7.0",
		"eslint-plugin-eslint-plugin": "7.6.0",
		"eslint-plugin-jsdoc": "65.5.0",
		"eslint-plugin-jsonc": "3.4.1",
		"eslint-plugin-markdown-links": "0.9.1",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-package-json": "1.14.0",
		"eslint-plugin-perfectionist": "5.14.0",
		"eslint-plugin-regexp": "3.3.1",
		"eslint-plugin-yml": "3.10.0",
		"husky": "9.1.7",
		"jiti": "2.7.0",
		"knip": "6.47.0",
		"prettier": "3.10.0",
		"prettier-plugin-curly": "0.4.1",
		"prettier-plugin-packagejson": "3.1.0",
		"prettier-plugin-padding-lines": "0.1.0",
		"prettier-plugin-sentences-per-line": "0.2.4",
		"prettier-plugin-sh": "0.20.0",
		"pretty-quick": "4.2.2",
		"release-it": "21.1.0",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"vitest": "5.1.0"
	},
	"peerDependencies": {
		"@typescript-eslint/parser": ">=8",
		"eslint": ">=9",
		"typescript": ">=5"
	},
	"packageManager": "pnpm@12.23.0",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	},
	"publishConfig": {
		"provenance": true
	}
}
